{
  "name": "relay",
  "displayName": "Relay",
  "description": "One panel for every AI coding session: Claude, Codex and friends, with forks.",
  "version": "0.0.1",
  "private": true,
  "publisher": "gregorg",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "relay",
          "title": "Relay",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "relay": [
        {
          "type": "webview",
          "id": "relay.sidebar",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "relay.newSession",
        "title": "New Session",
        "category": "Relay",
        "icon": "$(add)"
      },
      {
        "command": "relay.openAsTab",
        "title": "Open as Editor Tab",
        "category": "Relay",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "relay.newSession",
          "when": "view == relay.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "relay.openAsTab",
          "when": "view == relay.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Relay",
      "properties": {
        "relay.backend": {
          "type": "string",
          "enum": [
            "real",
            "mock"
          ],
          "default": "real",
          "enumDescriptions": [
            "Run sessions through the installed Claude Code and Codex CLIs.",
            "Fake providers with seeded sessions, for working on the UI."
          ],
          "description": "Where sessions run."
        },
        "relay.claudePath": {
          "type": "string",
          "default": "",
          "description": "Path to the claude executable. Empty: look on PATH and the usual install locations."
        },
        "relay.codexPath": {
          "type": "string",
          "default": "",
          "description": "Path to the codex executable. Empty: look on PATH and the usual install locations."
        },
        "relay.titleModel": {
          "type": "string",
          "default": "gpt-5.6-luna",
          "description": "Codex model that writes each session's title from your latest message. Without Codex, the title is the message's first line."
        },
        "relay.keepAwake": {
          "type": "boolean",
          "default": true,
          "description": "Keep the computer from idle-sleeping while an agent is working (macOS). The display can still sleep."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json",
    "vscode:prepublish": "npm run build -- --production"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.137.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.282",
    "markdown-it": "^15.0.2"
  }
}
